# Install as /etc/zapchast/backend.env, owned by root, mode 0600.
# Generate JWT_SECRET on the VPS; never commit the populated file.
APP_ENV=production
DEBUG=false
SITE_URL=https://zapchast.king.tj
DATABASE_URL=postgresql+psycopg://zapchast@/zapchast?host=/var/run/postgresql
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=["https://zapchast.king.tj"]
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
